{
  "manifest_version": 3,
  "name": "AI Usage Widget Companion",
  "version": "0.4.2",
  "description": "Locally syncs ChatGPT and Claude usage limits to the desktop widget.",
  "permissions": ["storage", "tabs", "windows", "offscreen"],
  "background": {"service_worker": "background.js"},
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1:8765/*"],
  "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["usage-parsers.js", "content.js"], "run_at": "document_idle"}]
}
